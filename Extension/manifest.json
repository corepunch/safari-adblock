{
  "manifest_version": 3,
  "name": "Cardea",
  "description": "Blocks ads and trackers in Safari, including ads in YouTube videos.",
  "version": "1.0",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png",
    "1024": "icon-1024.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["declarativeNetRequest", "scripting"],
  "host_permissions": ["*://*/*"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads", "enabled": true, "path": "rules.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "css": ["cosmetic.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://*.youtube.com/*", "*://youtube.com/*"],
      "js": ["content.js"],
      "css": ["youtube.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
